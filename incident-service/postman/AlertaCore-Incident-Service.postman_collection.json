      "name": "01 - Flujo principal",
      "item": [
        {
          "name": "Registrar incidente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/incidentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "incidentes"
              ]
            },
            "description": "Registra un incidente y guarda automáticamente el UUID en la variable incidenteId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"INUNDACION\",\n  \"descripcion\": \"Inundacion con varias personas afectadas en el sector\",\n  \"latitud\": 4.6579,\n  \"longitud\": -74.0596,\n  \"direccion\": \"Carrera 7 con Calle 72, Bogota\",\n  \"nombreReportante\": \"Operador de prueba\",\n  \"correoReportante\": \"operador@alertacore.com\",\n  \"telefonoReportante\": \"3001234567\",\n  \"cantidadPersonasAfectadas\": 15,\n  \"hayPersonasHeridas\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Respuesta contiene UUID y estado REPORTADO', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.exist;",
                  "  pm.expect(json.estado).to.eql('REPORTADO');",
                  "  pm.collectionVariables.set('incidenteId', json.id);",
                  "  pm.environment.set('incidenteId', json.id);",
                  "});",
                  "pm.test('Encabezado Location presente', () => pm.expect(pm.response.headers.get('Location')).to.exist);",
                  "pm.test('Tiempo de respuesta menor a 2000 ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar incidente por UUID",
