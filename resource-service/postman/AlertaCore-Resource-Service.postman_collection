  "item": [
    {
      "name": "Crear Recurso",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"codigoRecurso\")) {",
              "    pm.environment.set(\"codigoRecurso\", `AMB-POSTMAN-${Date.now()}`);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Recurso creado correctamente\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "const respuesta = pm.response.json();",
              "",
              "pm.test(\"La respuesta contiene recursoId\", function () {",
              "    pm.expect(respuesta.id).to.exist;",
              "});",
              "",
              "pm.test(\"El recurso inicia DISPONIBLE\", function () {",
              "    pm.expect(respuesta.estado).to.eql(\"DISPONIBLE\");",
              "});",
              "",
              "if (respuesta.id) {",
              "    pm.environment.set(\"recursoId\", respuesta.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"{{codigoRecurso}}\",\n  \"nombre\": \"Ambulancia Principal\",\n  \"tipo\": \"{{tipoRecurso}}\",\n  \"latitud\": {{latitudRecurso}},\n  \"longitud\": {{longitudRecurso}}\n}",
          "options": {
