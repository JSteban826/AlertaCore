    {
      "name": "Reservar Recurso",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"recursoId\")) {",
              "    throw new Error(\"Falta recursoId. Ejecute primero Crear Recurso.\");",
              "}",
              "",
              "if (!pm.environment.get(\"incidenteId\")) {",
              "    throw new Error(\"Falta incidenteId en el Environment.\");",
              "}",
              "",
              "if (!pm.environment.get(\"idempotencyKey\")) {",
              "    const uuid = pm.variables.replaceIn(\"{{$randomUUID}}\");",
              "    pm.environment.set(\"idempotencyKey\", `POSTMAN-${uuid}`);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reserva procesada correctamente\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "const respuesta = pm.response.json();",
              "",
              "if (respuesta.id) {",
              "    pm.environment.set(\"reservaId\", respuesta.id);",
              "} else if (respuesta.reservaId) {",
              "    pm.environment.set(\"reservaId\", respuesta.reservaId);",
              "}",
              "",
              "if (respuesta.estado) {",
              "    pm.test(\"La reserva queda ACTIVA\", function () {",
              "        pm.expect(respuesta.estado).to.eql(\"ACTIVA\");",
              "    });",
              "}"
            ]
          }
        }
      ],
